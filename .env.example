# Copy to .env and fill in. .env is gitignored; never commit real values.

# --- AWS -------------------------------------------------------------------
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
S3_BUCKET=cms-carecompare-raw
S3_PREFIX=raw/carecompare

# true = write raw files to ./data instead of S3 (no AWS account needed)
LOCAL_MODE=false

# --- Warehouse Postgres ----------------------------------------------------
WAREHOUSE_HOST=postgres
WAREHOUSE_PORT=5432
WAREHOUSE_DB=warehouse
WAREHOUSE_USER=warehouse
WAREHOUSE_PASSWORD=change_me

# --- Airflow ---------------------------------------------------------------
# In WSL, set this to the output of: id -u
AIRFLOW_UID=1000
AIRFLOW__CORE__EXECUTOR=LocalExecutor
AIRFLOW__CORE__LOAD_EXAMPLES=false
AIRFLOW__DATABASE__SQL_ALCHEMY_CONN=postgresql+psycopg2://airflow:change_me@postgres:5432/airflow
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=change_me

# --- Sources ---------------------------------------------------------------
# Quality data, monthly
CMS_PDC_API_BASE=https://data.cms.gov/provider-data/api/1
# Medicare SNF utilization, annual
CMS_DATA_API_BASE=https://data.cms.gov/data-api/v1
HTTP_TIMEOUT_SECONDS=120
HTTP_MAX_RETRIES=3
