# Copy to .env (gitignored) and replace every change_me.
# Then add your user id: echo "AIRFLOW_UID=$(id -u)" >> .env

# Airflow
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=change_me
# Any long random string, e.g. from: openssl rand -hex 32
AIRFLOW_JWT_SECRET=change_me

# Postgres: one server, two databases (airflow metadata, warehouse)
POSTGRES_PASSWORD=change_me
WAREHOUSE_HOST=postgres
WAREHOUSE_PORT=5432
WAREHOUSE_DB=warehouse
WAREHOUSE_USER=warehouse
WAREHOUSE_PASSWORD=change_me

# AWS S3 raw zone (from S3 on). LOCAL_MODE=true writes to ./data instead.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
S3_BUCKET=
LOCAL_MODE=false

# CMS sources
CMS_PDC_API_BASE=https://data.cms.gov/provider-data/api/1
CMS_DATA_API_BASE=https://data.cms.gov/data-api/v1
